-- 2. Combat & Troll Tab (Aimbot พร้อมวงกลม, ดีด, ออโต้ฆ่า)
-- ==========================================

local aimbot = false
local fovRadius = 150

-- สร้างวงกลม Aimbot (FOV Circle) บนหน้าจอ
local FOVDrawing = Drawing.new("Circle")
FOVDrawing.Visible = false
FOVDrawing.Radius = fovRadius
FOVDrawing.Color = Color3.fromRGB(0, 200, 255)
FOVDrawing.Thickness = 2
FOVDrawing.Filled = false
FOVDrawing.Transparency = 0.7

CombatTab:CreateToggle({
   Name = "เปิด/ปิด วงกลม Aimbot (FOV)",
   CurrentValue = false,
   Callback = function(Value)
      FOVDrawing.Visible = Value
   end,
})

CombatTab:CreateSlider({
   Name = "ขนาดวงกลม Aimbot",
   Range = {50, 400},
   Increment = 10,
   CurrentValue = 150,
   Callback = function(Value)
      fovRadius = Value
      FOVDrawing.Radius = Value
   end,
})

CombatTab:CreateToggle({
   Name = "Aimbot ล็อกหัวออโต้",
   CurrentValue = false,
   Callback = function(Value)
      aimbot = Value
   end,
})

RunService.RenderStepped:Connect(function()
    pcall(function()
        FOVDrawing.Position = UserInputService:GetMouseLocation()
        
        if aimbot then
            local target, shortest = nil, fovRadius
            local mousePos = UserInputService:GetMouseLocation()
            
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            if dist < shortest then
                                shortest = dist
                                target = p
                            end
                        end
                    end
                end
            end
            
            if target and target.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
            end
        end
    end)
end)

-- ดีดฆาตกรและนายอำเภอ
local function teleToVoid(roleName)
    pcall(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if getRole(p) == roleName then
                    p.Character.HumanoidRootPart.CFrame = CFrame.new(p.Character.HumanoidRootPart.Position.X, 99999, p.Character.HumanoidRootPart.Position.Z)
                end
            end
        end
    end)
end

CombatTab:CreateButton({
   Name = "ดีดฆาตกรออกแมพ",
   Callback = function() teleToVoid("Murderer") end,
})

CombatTab:CreateButton({
   Name = "ดีดนายอำเภอออกแมพ",
   Callback = function() teleToVoid("Sheriff") end,
})

-- ออโต้ฆ่าคน
local autoKill = false
CombatTab:CreateToggle({
   Name = "ออโต้ฆ่าคน (เมื่อเป็นฆาตกร)",
   CurrentValue = false,
   Callback = function(Value) autoKill = Value end,
})

task.spawn(function()
    while true do
        task.wait(0.3)
        pcall(function()
            if autoKill and getRole(LocalPlayer) == "Murderer" then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local hum = p.Character:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 and getRole(p) ~= "Murderer" then
                                myChar.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame
                            end
                        end
                    end
                end
            end
        end)
    end
end)

